---
import 'the-new-css-reset/css/reset.css';
import '@scss/main.scss';

import HTMLHead from '@components/html-head/HTML-Head.astro';
---

<!doctype html>

<html class="no-js" lang="en-GB" data-colour-mode="dark">

	<HTMLHead />

	<body>

		<main class:list={'main'}>

			<slot />

		</main>

	</body>

</html>

<style>

	.main {
		display: flex;
		justify-content: center;
		align-items: center;

		width: 100%;
		height: 100vh;
		padding: 3em 0;
	}

</style>
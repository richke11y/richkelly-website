---
// import './colour-mode.scss';

import IconLight from '@svg/icon-light.svg';
import IconDark from '@svg/icon-dark.svg';
import IconAuto from '@svg/icon-auto.svg';
---

<colour-mode>

	<button class="button" data-colour-mode="light" aria-label="Light Mode">

		<IconLight />

		<span>Light</span>

	</button>

	<button class="button" data-colour-mode="dark" aria-label="Dark Mode">

		<IconDark />

		<span>Dark</span>

	</button>

	<button class="button" data-colour-mode="auto" aria-label="Auto Mode">

		<IconAuto />

		<span>Auto</span>

	</button>

</colour-mode>

<script src="./colour-mode.js"></script>

<style>

	colour-mode {
		display: flex;
		justify-content: flex-end;
		grid-gap: 0 .5em;
	}

	.button {	
		display: flex;
		justify-content: center;
		align-items: center;
		grid-gap: 0 5px;
		
		height: 35px;
		padding: 5px 8px;

		background-color: transparent;
		border-width: 2px;
		border-radius: 50px;
		border-style: solid;

		font-family: var(--fontfamily-jetbrains-bold);
		font-size: 0.7em;
		line-height: 1em;
		text-transform: uppercase;

		cursor: pointer;
	}

	.button svg {
		display: block;
	}

	/* html[data-colour-mode="dark"] {} */

	html[data-colour-mode="dark"] .button {
		border-color: var(--colour-light-green);
	}

	html[data-colour-mode="dark"] .button:hover {
		background-color: var(--colour-light-green);
		color: var(--colour-dark-green);
	}

	html[data-colour-mode="dark"] .button[data-colour-mode="dark"] {
		background-color: var(--colour-light-green);
		color: var(--colour-dark-green);
	}

	/* html[data-colour-mode="light"] {} */

	html[data-colour-mode="light"] .button {
		border-color: var(--colour-dark-green);	
	}

	html[data-colour-mode="light"] .button:hover {
		background-color: var(--colour-dark-green);
		color: var(--colour-light-green);
	}

	html[data-colour-mode="light"] .button[data-colour-mode="light"]{
		background-color: var(--colour-dark-green);
		color: var(--colour-light-green);
	}

	@media (prefers-color-scheme: dark) {

		html[data-colour-mode="auto"] .button {

			border-color: var(--colour-light-green);

		}

		html[data-colour-mode="auto"] .button:hover {

			background-color: var(--colour-light-green);
			color: var(--colour-dark-green);

		}

		html[data-colour-mode="auto"] .button[data-colour-mode="auto"] {

			background-color: var(--colour-light-green);
			color: var(--colour-dark-green);

		}

	}

	@media (prefers-color-scheme: light) {

		html[data-colour-mode="auto"] .button {
			border-color: var(--colour-dark-green);
		}

		html[data-colour-mode="auto"] .button:hover {
			background-color: var(--colour-dark-green);
			color: var(--colour-light-green);
		}

		html[data-colour-mode="auto"] .button[data-colour-mode="auto"] {
			background-color: var(--colour-dark-green);
			color: var(--colour-light-green);
		}

	}

</style>
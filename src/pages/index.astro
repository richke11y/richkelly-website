---
// import '@scss/pages/_index.scss';

import Layout from '@layouts/Layout.astro';
import ColourMode from '@components/colour-mode/Colour-Mode.astro';
---
<Layout>
	
	<div class:list={'page-container'}>

		<div class="page-colour">

			<ColourMode />

		</div>

		<div class:list={'page-titles'}>

			<h1 set:text={'_richkelly'} class:list={'title title--h1'} />
	
			<h2 set:text={'Independent Frontend Web Development'} class:list={'title title--h2'} />

		</div>

		<div class:list={'page-body'}>

			<p set:text={'Hi, my name is Rich and I\'m a front-end web developer with over 15 years experience building websites for customers in the hospitality, restaurant, music, clothing and jewellery sectors.'} />

			<p set:text={'I\'m always on the look out for new projects and opportunities so don\'t hesitate to get in touch.'} />

			<ul class:list={'links-list'}>

				<li>
					<a set:text={'github.com/richke11y'} class:list={'link link--inline-block link--external'} href={'https://github.com/richke11y'} target={'_blank'} title={'github.com/richke11y'} rel={'noopener noreferrer'} />
				</li>

				<li>
					<a set:text={'hello@richkelly.uk'} class:list={'link link--inline-block'} href={'mailto:hello@richkelly.uk'} target={'_blank'} title={'hello@richkelly.uk'} rel={'noopener noreferrer'} />
				</li>

			</ul>

		</div>

	</div>

</Layout>

<style>

	.page-container {
		display: flex;
		flex-direction: column;

		width: 100%;
		height: 100%;
		position: relative;
		padding: 0 7vw;
	}

	.page-colour {
		display: flex;
		justify-content: flex-end;
	}

	.page-body {
		width: min(100%, 60ch);
		margin: 5ch 0 0 0;
	}

	.links-list {
		margin: 3ch 0 0 0;
	}

	@media screen and (max-width: 767px) {

		.page-container {
			justify-content: center;
		}

		.page-colour {
			position: absolute;
			top: 0;
		}

	}

	@media screen and (min-width: 768px) {

		.page-titles {
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
		
			height: calc(50vh - 3em);
		}

	}

</style>